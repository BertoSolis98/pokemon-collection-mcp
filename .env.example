# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://dev.pokemontcg.io/ (the API also works without one,
# but with much lower rate limits).
POKEMONTCG_API_KEY=

# Optional: where the SQLite database lives.
# Default: ~/.pokemon-mcp/collection.db
POKEMON_MCP_DB_PATH=

# Optional: fall back to TCGdex for prices when pokemontcg.io is down
# (TCGplayer USD prices only). Set to "off" to disable. Default: on.
POKEMON_MCP_PRICE_FALLBACK=
